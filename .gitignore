# IDE
.idea/
*.iml
.vscode/

# OS
Thumbs.db
.DS_Store

# Python (outils d'import)
__pycache__/
*.py[cod]

# Sortie de tools/import_shamela.py (plusieurs centaines de Mo, régénérable)
/dist/

# Graine de catalogue embarquée : artefact de build, récupérée du bucket par
# `scripts/fetch-seed.mjs`. La versionner mettrait plusieurs Mo de binaire dans
# l'historique à chaque publication. Le jeu d'exemple, lui, reste versionné.
apps/desktop/assets/catalog.sqlite.zst
apps/desktop/assets/catalog-seed.json

# Artefacts d'electron-builder
apps/desktop/release/

# Site : le rendu et les données relevées depuis l'API GitHub sont des
# artefacts. Les sources (gabarits, locales, captures curées) sont versionnées.
site/dist/
site/data/

# Maquettes jetables du compagnon visuel de brainstorming
.superpowers/

# Réglages locaux de l'agent, et surtout `.claude/worktrees/` : des copies
# complètes du dépôt. Un `git add -A` distrait les ferait entrer dans
# l'historique.
.claude/

# Identifiants du bucket de distribution. Jamais dans le dépôt.
.env
.env.*
!.env.example

# --- clés de signature ------------------------------------------------------
#
# Exclues **par extension et partout**, jamais par dossier. La clé d'upload
# d'Android n'a pas de place naturelle : la pente est de la déposer à côté des
# certificats publics de `certificates/`, ou dans `apps/mobile/android/` — qui
# est engendré, donc où elle disparaîtrait au premier `npx cap add android`.
# Une règle par dossier ne couvrirait ni l'un ni l'autre cas.
#
# Ce qui est en jeu : une clé privée entrée dans l'historique y reste après le
# commit qui la retire, et doit être tenue pour compromise définitivement. La
# réparation n'est pas un `git rm` — c'est une demande de réinitialisation de
# clé d'upload auprès de Google, et plusieurs jours d'attente.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Le chemin et les mots de passe de cette clé. Le `.example` reste suivi : il
# dit quelles clés existent, sans en porter aucune valeur.
keystore.properties
!keystore.properties.example
