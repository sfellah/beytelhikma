<?xml version="1.0" encoding="utf-8"?>
<!--
  L'encre monte. Cible : `icone`, la racine du `<vector>`.

  Plus court que le grandissement, et à dessein : la forme finit d'arriver
  après que la couleur est pleine, sinon les deux gestes se confondent en un
  seul fondu mou.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="alpha"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:duration="320"
    android:interpolator="@android:interpolator/decelerate_cubic" />
