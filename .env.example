# Identifiants du bucket de distribution des livres, lus par tools/publish_minio.py.
# Copier en `.env` et remplir. Le vrai `.env` est ignoré par git.

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
BUCKET_NAME=

# MinIO local — alternative aux clés AWS ci-dessus
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
